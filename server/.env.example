# Copy to .env and fill in values. Never commit .env.

PORT=5000
CLIENT_URL=http://localhost:5173
# Production frontend URL (uncomment when you move to production)
# CLIENT_URL=https://www.kattraan.com
MONGO_URI=

# Must be named JWT_* (not JMT_*). Required for login/refresh cookies.
JWT_SECRET=
JWT_REFRESH_SECRET=

# Optional: strict | lax | none. If unset, production uses none when CLIENT_URL host
# differs from RENDER_EXTERNAL_URL / API_PUBLIC_URL (Vercel + Render).
# AUTH_COOKIE_SAME_SITE=

# Cashfree (Dashboard → Developers → API Keys — use production keys in production)
# For local testing without keys: CASHFREE_MOCK=true (never enable in production)
CASHFREE_MOCK=true
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
# Optional overrides for return / webhook URLs
# CASHFREE_RETURN_URL=
# CASHFREE_NOTIFY_URL=

# Bunny Stream
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
# Stream CDN hostname (vz-*). Used for video playback only.
# BUNNY_CDN_URL=
# Prefer the library Read-Only API key for webhook HMAC (falls back to BUNNY_API_KEY)
# BUNNY_STREAM_WEBHOOK_SECRET=

# Bunny Storage (cover images, docs, etc.)
# BUNNY_STORAGE_ZONE_NAME=
# BUNNY_STORAGE_PASSWORD=
# BUNNY_STORAGE_REGION=sg
# Storage pull zone hostname — NOT the Stream vz-* host
# BUNNY_STORAGE_CDN_HOSTNAME=kattraan.b-cdn.net
# Optional: token auth key for the storage pull zone
# BUNNY_STORAGE_PULL_ZONE_TOKEN_KEY=

# Initial admin (created once on first boot if missing; never resets existing password)
# ADMIN_EMAIL=admin@kattran.com
# ADMIN_PASSWORD=
